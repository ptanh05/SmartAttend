# SmartAttend — Environment Configuration Template
# Copy this file to .env or .env.local for local development.

# PostgreSQL connection string (Neon serverless PostgreSQL recommended)
# Format: postgresql://[user]:[password]@[host]/[database]?sslmode=require
DATABASE_URL=

# Secret API key required for teacher registration endpoint (/api/auth/register)
# Generate a high-entropy random string (e.g. openssl rand -base64 32)
TEACHER_REGISTRATION_API_KEY=

# Global cryptographic secret for WebAuthn challenge tokens & acoustic HMAC signatures
# In production, this MUST be set or the server will fail-fast at startup.
SESSION_SECRET=

# WebAuthn / FIDO2 Configuration
# WEBAUTHN_RP_ID: Relying Party Identifier (e.g. 'smartattend.edu.vn' or 'localhost')
WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_ORIGIN: Application Origin (e.g. 'https://smartattend.edu.vn' or 'http://localhost:3000')
WEBAUTHN_ORIGIN="http://localhost:3000"

# Microsoft 365 / Entra ID SSO Configuration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI="http://localhost:3000/api/auth/microsoft/callback"

# Node environment ('development' | 'production' | 'test')
# When set to 'production', session cookies enforce the Secure attribute (HTTPS only).
NODE_ENV=development
